# Copy this file to .env and fill in real values. NEVER commit .env.
# Load it with:  set -a; source .env; set +a

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Optional: Google Safe Browsing API key (free for non-commercial use)
GOOGLE_SAFE_BROWSING_API_KEY=

# A long random password for the private dashboard (/api/stats?public=0)
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(24))"
ADMIN_TOKEN=

# Where anonymous counts are stored (SQLite file)
SCAM_STATS_DB=data/stats.db
